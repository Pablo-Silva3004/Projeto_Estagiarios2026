  "description": "Sistema de Gerenciamento de Ordens de Fabricação",
  "scripts": {
    "start": "ESBUILD_BINARY_PATH=./node_modules/@angular-devkit/build-angular/node_modules/@esbuild/linux-x64/bin/esbuild ng serve",
